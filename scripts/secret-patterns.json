[
  {
    "name": "private key",
    "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
  },
  {
    "name": "GitHub token",
    "pattern": "\\bgh[pousr]_[A-Za-z0-9_]{30,}\\b"
  },
  {
    "name": "AWS access key",
    "pattern": "\\bAKIA[0-9A-Z]{16}\\b"
  },
  {
    "name": "sk-prefixed provider token",
    "pattern": "\\bsk-[A-Za-z0-9_-]{20,}\\b"
  },
  {
    "name": "Google API key",
    "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b"
  },
  {
    "name": "NVIDIA API key",
    "pattern": "\\bnvapi-[A-Za-z0-9_-]{20,}\\b",
    "flags": "i"
  },
  {
    "name": "assigned credential",
    "pattern": "(?:api[_-]?key|access[_-]?token|authorization|client[_-]?secret)\\s*[:=]\\s*[\"'][A-Za-z0-9_./+=-]{16,}[\"']",
    "flags": "i"
  }
]
