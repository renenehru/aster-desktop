{
  "name": "aster-desktop",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "A security-focused, local-first desktop client for the Z.AI chat API.",
  "homepage": "https://github.com/renenehru/aster-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renenehru/aster-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/renenehru/aster-desktop/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:config": "node scripts/security-audit.mjs",
    "license:frontend": "node scripts/license-policy.mjs",
    "license:rust": "node scripts/rust-license-policy.mjs",
    "sbom:frontend": "node scripts/generate-sbom.mjs",
    "sbom:rust": "node scripts/generate-rust-sbom.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:run && pnpm security:secrets && pnpm security:config && pnpm build",
    "audit:frontend": "pnpm audit --audit-level high --prod",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock",
    "verify": "pnpm check && pnpm audit:frontend && pnpm license:frontend && pnpm license:rust && pnpm sbom:frontend && pnpm sbom:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@tauri-apps/cli": "2.11.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
